#!/usr/bin/expect

# Percorre o assistente do yby init (um formulário só, uma etapa por grupo) e cancela na
# revisão: confere as etapas e o resumo sem gravar nada no diretório.

set timeout 20

spawn yby init

# 1. PROJETO: destino (padrão .), repositório e nome
expect "ONDE CRIAR O PROJETO"
send "\r"
send "https://github.com/teste/validacao\r"
send "projeto-interativo\r"

# 2. AMBIENTES: topologia e workflow (padrões standard e gitflow)
expect "TOPOLOGIA DE AMBIENTES"
send "\r"
send "\r"

# 3. CLUSTER: domínio e e-mail (ctrl+u apaga o padrão)
expect "DOMÍNIO BASE DO CLUSTER"
send "\025teste.local\r"
send "\025admin@teste.local\r"

# 4. MÓDULOS: nenhum módulo e DevContainer
expect "MÓDULOS ADICIONAIS"
send "\r"
expect "INCLUIR DEVCONTAINER?"
send "y"

# 5. IA: desligada
expect "ATIVAR O ASSISTENTE DE IA"
send "n"

# 6. REVISÃO: o resumo traz as respostas; Cancelar não grava nada
expect "GERAR O PROJETO?"
expect "projeto-interativo"
expect "teste.local · admin@teste.local"
send "n"
expect "init cancelado"

expect eof
